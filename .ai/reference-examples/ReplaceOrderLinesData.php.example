<?php

declare(strict_types=1);

namespace Lahatre\Example\Data;

use Illuminate\Support\Collection;

final readonly class ReplaceOrderLinesData
{
    /**
     * @param  Collection<int, array{productId: string, quantity: int}>  $lines
     */
    private function __construct(
        public string $productType,
        public Collection $lines,
    ) {}

    /**
     * Build typed service input from already validated HTTP data.
     *
     * @param  array{product_type: string, lines: array<int, array{product_id: string, quantity: int}>}  $data
     */
    public static function fromArray(array $data): self
    {
        return new self(
            productType: $data['product_type'],
            lines: collect($data['lines'])->map(
                fn (array $line): array => [
                    'productId' => $line['product_id'],
                    'quantity'  => $line['quantity'],
                ],
            ),
        );
    }
}
