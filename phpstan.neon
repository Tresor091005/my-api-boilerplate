includes:
    - ./vendor/larastan/larastan/extension.neon
    - ./vendor/pestphp/pest/extension.neon

parameters:
    paths:
        - app
        - app-modules
        - bootstrap
        - database
        - routes
        - tests

    level: 5

    excludePaths:
        - storage
        - bootstrap/cache
        - vendor
        - node_modules (?)

    inferPrivatePropertyTypeFromConstructor: true

    ignoreErrors:
        -
            message: '#Access to an undefined property (?:PHPUnit\\Framework\\TestCase|Pest\\PendingCalls\\TestCall)::\$[a-zA-Z0-9_]+#'
            path: 'tests/**'
        -
            message: '#Access to an undefined property (?:PHPUnit\\Framework\\TestCase|Pest\\PendingCalls\\TestCall)::\$[a-zA-Z0-9_]+#'
            path: 'app-modules/*/tests/**'
        -
            message: '#Call to an undefined method (?:PHPUnit\\Framework\\TestCase|Pest\\PendingCalls\\TestCall)::(fail|assertDatabaseCount|assertDatabaseHas|withToken|getJson|postJson|putJson|patchJson|deleteJson|withoutMiddleware|initializeCatalogTenantContext|initializeCustomerTenantContext|initializeMasterTenantContext|initializePricingTenantContext|ensureInventoryTestTables|ensurePricingTestTables|createTestMaterial|createTestAltMaterial|createTestWarehouse|createTestPriceable|createTestParty)\(\)#'
            path: 'tests/**'
        -
            message: '#Call to an undefined method (?:PHPUnit\\Framework\\TestCase|Pest\\PendingCalls\\TestCall)::(fail|assertDatabaseCount|assertDatabaseHas|withToken|getJson|postJson|putJson|patchJson|deleteJson|withoutMiddleware|initializeCatalogTenantContext|initializeCustomerTenantContext|initializeMasterTenantContext|initializePricingTenantContext|ensureInventoryTestTables|ensurePricingTestTables|createTestMaterial|createTestAltMaterial|createTestWarehouse|createTestPriceable|createTestParty)\(\)#'
            path: 'app-modules/*/tests/**'
        -
            message: '#Trait Lahatre\\(Catalog|Customer|Inventory|Master)\\Tests\\Concerns\\.* is used zero times and is not analysed\.#'
            path: 'app-modules/*/tests/Concerns/**'
        -
            message: '#Access to an undefined property Pest\\Mixins\\Expectation.*::\$not#'
            path: 'app-modules/*/tests/**'

    scanFiles:
        - bootstrap/app.php
        - tests/Pest.php
