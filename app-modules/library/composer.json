{
    "name": "lahatre/library",
    "description": "Private, tenant-scoped file library for Lahatre applications.",
    "type": "library",
    "version": "1.0",
    "license": "proprietary",
    "require": {},
    "autoload": {
        "psr-4": {
            "Lahatre\\Library\\": "src/",
            "Lahatre\\Library\\Tests\\": "tests/",
            "Lahatre\\Library\\Database\\Factories\\": "database/factories/",
            "Lahatre\\Library\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Lahatre\\Library\\Providers\\LibraryServiceProvider"
            ]
        }
    }
}
