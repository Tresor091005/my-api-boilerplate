<?php

declare(strict_types=1);

namespace Lahatre\{{Module}}\Services;

use Illuminate\Support\Facades\DB;
use Lahatre\{{Module}}\Assertions\{{Entity}}Assertion;
use Lahatre\{{Module}}\Data\{{Entity}}Data;
use Lahatre\{{Module}}\Http\Resources\{{Entity}}Resource;
use Lahatre\{{Module}}\Models\{{Entity}};
use Lahatre\Shared\Data\MissingValue;
use Lahatre\Shared\Services\Contracts\StandaloneService;

class {{ClassName}} implements StandaloneService
{
    public function __construct(
        protected {{Entity}}Assertion $assertion
    ) {}

    public function create({{Entity}}Data $data): {{Entity}}Resource
    {
        $model = new {{Entity}}();

        $model->fill([
            'name' => MissingValue::required($data->name),
            // Explicit mapping
        ]);

        DB::transaction(fn () => $model->save());

        return {{Entity}}Resource::make($model);
    }
}
