<?php

declare(strict_types=1);

namespace Lahatre\{{Module}}\Exceptions;

use Lahatre\{{Module}}\Models\{{Entity}};
use Lahatre\Shared\Exceptions\AssertionException;

final class {{ClassName}} extends AssertionException
{
    public static function {{FailureFactory}}({{Entity}} $entity): self
    {
        return new self(
            __('{{ModuleLower}}::exceptions.{{TranslationKey}}'),
            [
                '{{EntityLower}}_id' => $entity->getKey(),
            ]
        );
    }

    private function __construct(string $message, array $context = [])
    {
        parent::__construct($message, $context);
    }
}
