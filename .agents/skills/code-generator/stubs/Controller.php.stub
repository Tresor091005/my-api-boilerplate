<?php

declare(strict_types=1);

namespace Lahatre\{{Module}}\Http\Controllers;

use Illuminate\Http\JsonResponse;
use Illuminate\Support\Facades\Gate;
use Lahatre\{{Module}}\Data\{{Entity}}Data;
use Lahatre\{{Module}}\Data\{{Entity}}FilterData;
use Lahatre\{{Module}}\Http\Requests\{{Entity}}Request;
use Lahatre\{{Module}}\Http\Requests\{{Entity}}FilterRequest;
use Lahatre\{{Module}}\Http\Resources\{{Entity}}Resource;
use Lahatre\{{Module}}\Models\{{Entity}};
use Lahatre\{{Module}}\Services\{{Entity}}Service;
use Lahatre\ResponseSelection\ApiResponse;
use Symfony\Component\HttpFoundation\Response;

class {{ClassName}}
{
    public function __construct(
        protected {{Entity}}Service $service,
    ) {}

    public function index({{Entity}}FilterRequest $request): JsonResponse|Response
    {
        Gate::authorize('list', {{Entity}}::class);

        $response = $this->service->list({{Entity}}FilterData::fromArray($request->validated()));

        return ApiResponse::cursorPage($response, {{Entity}}Resource::class);
    }

    public function store({{Entity}}Request $request): JsonResponse|Response
    {
        Gate::authorize('create', {{Entity}}::class);

        $data = {{Entity}}Data::fromArray($request->validated());

        $response = $this->service->create($data);

        return ApiResponse::item($response, {{Entity}}Resource::class, 201);
    }

    public function show({{Entity}} ${{EntityLower}}): JsonResponse|Response
    {
        Gate::authorize('retrieve', ${{EntityLower}});

        $response = $this->service->retrieve(${{EntityLower}});

        return ApiResponse::item($response, {{Entity}}Resource::class);
    }

    public function update({{Entity}}Request $request, {{Entity}} ${{EntityLower}}): JsonResponse|Response
    {
        Gate::authorize('update', ${{EntityLower}});

        $data = {{Entity}}Data::fromArray($request->validated(), missingFields: []);

        $response = $this->service->update(${{EntityLower}}, $data);

        return ApiResponse::item($response, {{Entity}}Resource::class);
    }

    public function destroy({{Entity}} ${{EntityLower}}): Response
    {
        Gate::authorize('delete', ${{EntityLower}});

        $this->service->delete(${{EntityLower}});

        return ApiResponse::noContent();
    }
}
