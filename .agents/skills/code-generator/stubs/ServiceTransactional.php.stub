/**
 * Perform a reusable {{Entity}} mutation inside the caller's transaction.
 */
final class {{ClassName}}
{
    public function __construct(
        private {{Entity}}Assertion $assertion,
    ) {}

    /**
     * Apply an already authorized and validated mutation.
     *
     * The caller supplies tenant-constrained models and owns the transaction.
     * This method must not call DB::transaction().
