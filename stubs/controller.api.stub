<?php

declare(strict_types=1);

namespace {{ namespace }};

use IlluminateHttpJsonResponse;
use IlluminateHttpRequest;
use IlluminateHttpResponse;
use Illuminate\Http\Resources\Json\JsonResource;
use Lahatre\Shared\Http\Responses\ResponseResponder;

final class {{ class }}
{
    public function __construct(
        private ResponseResponder $responseResponder,
    ) {}

    public function index(Request $request): JsonResource|JsonResponse|Response
    {
        return $this->responseResponder->respond(
            fn (): JsonResource => JsonResource::make([]),
        );
    }

    public function store(Request $request): JsonResource|JsonResponse|Response
    {
        return $this->responseResponder->respond(
            fn (): JsonResource => JsonResource::make([]),
            status: 201,
        );
    }

    public function show(string $id): JsonResource|JsonResponse|Response
    {
        return $this->responseResponder->respond(
            fn (): JsonResource => JsonResource::make([]),
        );
    }

    public function update(Request $request, string $id): JsonResource|JsonResponse|Response
    {
        return $this->responseResponder->respond(
            fn (): JsonResource => JsonResource::make([]),
        );
    }

    public function destroy(string $id): Response
    {
        return response()->noContent();
    }
}
